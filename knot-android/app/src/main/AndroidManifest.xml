<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- 前台服务（M2.2 后台剪贴板同步）：保进程不被冻结 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 附近设备（API 33+ 归入运行时权限组）：局域网发现扫描需要；声明不用于定位 -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        android:minSdkVersion="33" />

    <application
        android:label="KnotYup"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.KnotYup"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KnotYup">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 分享发送：任何 App 里分享文本到 KnotYup 即广播到群 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- 触摸板控制页：独立 window、全屏横屏；与群页触摸/返回完全隔离 -->
        <activity
            android:name=".TouchpadControlActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:theme="@style/Theme.KnotYup" />

        <!-- 群组前台服务：入群期间常驻，保 ws 连接（后台剪贴板改由悬浮通知告知） -->
        <service
            android:name=".service.KnotForegroundService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 悬浮通知「复制」按钮：写入剪贴板并同步防回环闸门 -->
        <receiver
            android:name=".service.ClipboardCopyReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.knotyup.android.COPY_CLIPBOARD" />
            </intent-filter>
        </receiver>

        <!-- 悬浮通知「下载」按钮：从供种者 P2P 拉取共享文件 -->
        <receiver
            android:name=".service.FileDownloadReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.knotyup.android.DOWNLOAD_FILE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
