{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KnotYup",
  "version": "0.1.0",
  "identifier": "com.knotyup.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "KnotYup",
        "width": 980,
        "height": 660,
        "minWidth": 780,
        "minHeight": 540,
        "center": true,
        "backgroundColor": "#F6F7F9"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
